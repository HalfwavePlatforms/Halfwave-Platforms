# ==============================================================================
# Halfwave Platforms - Backend API Environment Template
# ==============================================================================
# Copy this file to .env inside apps/api/ or at repository root.
# ==============================================================================

NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/halfwave_db?schema=public"

# Redis Cache & BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
JWT_ACCESS_SECRET="generate_a_secure_random_string_min_32_chars"
JWT_REFRESH_SECRET="generate_a_secure_random_string_min_32_chars"

# Third-Party Integrations
CLOUDINARY_CLOUD_NAME="mock_cloudinary_cloud_name"
CLOUDINARY_API_KEY="mock_cloudinary_api_key"
CLOUDINARY_API_SECRET="mock_cloudinary_api_secret"

RESEND_API_KEY="re_mock_resend_api_key"
EMAIL_FROM="Halfwave Platforms <contact@halfwaveplatforms.com>"
