{
  "name": "halfwave-platforms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Monorepo for Halfwave Platforms",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "start:all": "node scripts/dev.js",
    "start:api": "npm --prefix apps/api run start:dev",
    "start:web": "node apps/web/server.js",
    "build": "npm --prefix apps/api run build",
    "build:api": "npm --prefix apps/api run build",
    "typecheck": "npm --prefix apps/api run build",
    "lint": "npm --prefix apps/api run lint",
    "test": "npm --prefix apps/api run test",
    "prisma:generate": "npm --prefix apps/api run prisma:generate",
    "prisma:migrate": "npm --prefix apps/api run prisma:migrate",
    "prisma:seed": "npm --prefix apps/api run prisma:seed",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "verify": "node scripts/verify.js"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
