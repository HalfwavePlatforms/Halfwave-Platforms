datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// CUSTOM ENUMS
// ==============================================================================

enum Status {
  active
  suspended
}

enum JobType {
  full_time
  part_time
  contract
  internship
}

enum AppStatus {
  applied
  reviewing
  interviewing
  offered
  rejected
  withdrawn
}

enum ContactStatus {
  new
  contacted
  in_progress
  completed
  closed
}

// ==============================================================================
// MODELS
// ==============================================================================

model User {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String @unique
  passwordHash String @map("password_hash")
  firstName    String @map("first_name")
  lastName     String @map("last_name")
  roleId       String @map("role_id") @db.Uuid
  role         Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status       Status @default(active)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Authentication & Security Columns
  refreshTokenHash     String?   @map("refresh_token_hash")
  isEmailVerified      Boolean   @default(false) @map("is_email_verified")
  verificationToken    String?   @map("verification_token")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires") @db.Timestamptz

  // Audit Relations
  createdServices       Service[]           @relation("ServiceCreatedBy")
  updatedServices       Service[]           @relation("ServiceUpdatedBy")
  createdCategories     PortfolioCategory[] @relation("CategoryCreatedBy")
  updatedCategories     PortfolioCategory[] @relation("CategoryUpdatedBy")
  createdPortfolioItems PortfolioItem[]     @relation("PortfolioCreatedBy")
  updatedPortfolioItems PortfolioItem[]     @relation("PortfolioUpdatedBy")
  createdTeamMembers    TeamMember[]        @relation("TeamCreatedBy")
  updatedTeamMembers    TeamMember[]        @relation("TeamUpdatedBy")
  createdJobPostings    JobPosting[]        @relation("JobCreatedBy")
  updatedJobPostings    JobPosting[]        @relation("JobUpdatedBy")
  createdJobApps        JobApplication[]    @relation("JobAppCreatedBy")
  updatedJobApps        JobApplication[]    @relation("JobAppUpdatedBy")
  createdTestimonials   Testimonial[]       @relation("TestimonialCreatedBy")
  updatedTestimonials   Testimonial[]       @relation("TestimonialUpdatedBy")
  createdClientLogos    ClientLogo[]        @relation("ClientLogoCreatedBy")
  updatedClientLogos    ClientLogo[]        @relation("ClientLogoUpdatedBy")
  createdSiteSettings   SiteSetting[]       @relation("SiteSettingCreatedBy")
  updatedSiteSettings   SiteSetting[]       @relation("SiteSettingUpdatedBy")

  // Submissions and Activity logs
  assignedContacts ContactSubmission[] @relation("ContactAssignee")
  auditLogs        AuditLog[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityName String   @map("entity_name")
  entityId   String?  @map("entity_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([entityName, entityId])
  @@map("audit_logs")
}

model Service {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String  @unique
  title        String
  summary      String
  description  String
  icon         String
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy User? @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("services")
}

model PortfolioCategory {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique
  name String

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy User? @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  portfolioItems PortfolioItem[]

  @@map("portfolio_categories")
}

model PortfolioItem {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String    @unique
  categoryId   String?   @map("category_id") @db.Uuid
  title        String
  description  String
  thumbnailUrl String    @map("thumbnail_url")
  projectUrl   String?   @map("project_url")
  clientName   String?   @map("client_name")
  completedAt  DateTime? @map("completed_at") @db.Date
  isFeatured   Boolean   @default(false) @map("is_featured")
  isPublished  Boolean   @default(false) @map("is_published")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  category  PortfolioCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?              @relation("PortfolioCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?              @relation("PortfolioUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  images    PortfolioImage[]

  @@index([categoryId])
  @@index([isFeatured, isPublished])
  @@index([isPublished])
  @@map("portfolio_items")
}

model PortfolioImage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portfolioItemId String   @map("portfolio_item_id") @db.Uuid
  imageUrl        String   @map("image_url")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@index([portfolioItemId])
  @@index([portfolioItemId, displayOrder])
  @@map("portfolio_images")
}

model TeamMember {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  roleTitle    String  @map("role_title")
  bio          String
  avatarUrl    String  @map("avatar_url")
  linkedinUrl  String? @map("linkedin_url")
  githubUrl    String? @map("github_url")
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy User? @relation("TeamCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("TeamUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, displayOrder])
  @@map("team_members")
}

model JobPosting {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String    @unique
  title            String
  department       String
  location         String
  employmentType   JobType   @map("employment_type")
  experienceLevel  String    @map("experience_level")
  description      String
  requirements     String[]
  responsibilities String[]
  salaryRangeMin   Decimal?  @map("salary_range_min") @db.Decimal(12, 2)
  salaryRangeMax   Decimal?  @map("salary_range_max") @db.Decimal(12, 2)
  isActive         Boolean   @default(true) @map("is_active")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy    User?            @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?            @relation("JobUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([isActive, expiresAt])
  @@map("job_postings")
}

model JobApplication {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobPostingId String    @map("job_posting_id") @db.Uuid
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String
  phone        String
  resumeUrl    String    @map("resume_url")
  coverLetter  String?   @map("cover_letter")
  linkedinUrl  String?   @map("linkedin_url")
  portfolioUrl String?   @map("portfolio_url")
  status       AppStatus @default(applied)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Restrict)
  createdBy  User?      @relation("JobAppCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?      @relation("JobAppUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([jobPostingId])
  @@index([status])
  @@map("job_applications")
}

model ContactSubmission {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  email             String
  phone             String?
  company           String?
  serviceInterested String        @map("service_interested")
  budget            String?
  message           String
  status            ContactStatus @default(new)
  internalNotes     String?       @map("internal_notes")
  assignedTo        String?       @map("assigned_to") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  assignee User? @relation("ContactAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String
  isActive       Boolean   @default(true) @map("is_active")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at") @db.Timestamptz
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  // NOTE: Unique constraint on active emails (WHERE deleted_at IS NULL) 
  // is set via raw SQL migration as Prisma does not support partial unique indexes.

  @@map("newsletter_subscribers")
}

model Testimonial {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientName    String  @map("client_name")
  clientRole    String  @map("client_role")
  clientCompany String  @map("client_company")
  avatarUrl     String? @map("avatar_url")
  content       String
  rating        Int
  isFeatured    Boolean @default(false) @map("is_featured")
  isActive      Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy User? @relation("TestimonialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("TestimonialUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, isFeatured])
  @@map("testimonials")
}

model ClientLogo {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientName   String  @map("client_name")
  logoUrl      String  @map("logo_url")
  websiteUrl   String? @map("website_url")
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  createdBy User? @relation("ClientLogoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ClientLogoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, displayOrder])
  @@map("client_logos")
}

model SiteSetting {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique
  value       Json
  description String?

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  createdBy User? @relation("SiteSettingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("SiteSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  roles Role[]

  @@map("permissions")
}
