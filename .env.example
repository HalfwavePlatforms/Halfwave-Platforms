# ==============================================================================
# Halfwave Platforms - Root Environment Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual secrets.
# NEVER commit the real .env file to version control.
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://halfwaveplatforms.com

# PostgreSQL Database Connection (Prisma)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/halfwave_db?schema=public"

# Redis Cache & Background Queue (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets (Generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET="replace_with_a_secure_64_character_random_string_for_access_token"
JWT_REFRESH_SECRET="replace_with_a_secure_64_character_random_string_for_refresh_token"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Transactional Email Service (Resend / SMTP)
RESEND_API_KEY="re_mock_resend_api_key_for_development"
EMAIL_FROM="Halfwave Platforms <contact@halfwaveplatforms.com>"
ADMIN_NOTIFICATION_EMAIL="admin@halfwaveplatforms.com"
