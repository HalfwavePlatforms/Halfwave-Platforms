# ==============================================================================
# Halfwave Platforms Backend Environment Configuration
# ==============================================================================
# Copy this file to '.env' for local development and supply your actual credentials.
# In production, inject these variables at the host/container level.

# ------------------------------------------------------------------------------
# App Core Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Prisma database connection string URL format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/halfwave_db?schema=public"

# ------------------------------------------------------------------------------
# Caching Configuration (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Authentication Secrets (JWT)
# ------------------------------------------------------------------------------
# Generate secure random secrets using: openssl rand -base64 32
JWT_ACCESS_SECRET=super_secure_and_random_jwt_access_secret_key_change_me
JWT_REFRESH_SECRET=super_secure_and_random_jwt_refresh_secret_key_change_me

# ------------------------------------------------------------------------------
# Media Storage Configuration (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# Email Provider Configuration (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Halfwave Platforms <no-reply@halfwaveplatforms.com>"
