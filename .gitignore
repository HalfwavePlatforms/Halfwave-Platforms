# ==============================================================================
# Enterprise GitIgnore - Halfwave Platforms Monorepo
# ==============================================================================

# Secrets and Environment Configuration (CRITICAL - NEVER COMMIT)
.env
.env.*
*.env
*.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.pfx

# Allow environment templates
!.env.example
!apps/*/.env.example
!packages/*/.env.example

# Node Dependencies & Package Managers
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks

# Compilation & Build Outputs
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/
*.tsbuildinfo

# Monorepo & Build Caches
.turbo/
.nx/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/

# Database & Migration Artifacts
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
prisma/migrations/*/*.sql.lock
dump.rdb

# Logs & Runtime Process IDs
logs/
*.log
*.pid
*.seed
*.pid.lock

# IDEs & Editor Configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
[Dd]esktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~
